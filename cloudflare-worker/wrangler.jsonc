{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leva-ai-mvp",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEMO_MODE": "true",
    "MAPS_USER_AGENT": "LevaAi-AcademicMVP/0.1"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fbc23a2b3526475e8b1855a8dc8b97c8"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
