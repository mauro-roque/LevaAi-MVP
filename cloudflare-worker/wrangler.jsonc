{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leva-ai-mvp",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
