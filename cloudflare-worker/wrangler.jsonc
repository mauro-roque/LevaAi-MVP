{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leva-ai-platform",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEMO_MODE": "false",
    "DEMO_VERIFICATION_CODE": "abc",
    "EMAIL_VERIFICATION_REQUIRED": "true",
    "GOOGLE_CLIENT_ID": "797443734570-clr40j3are8aidg8mtuc1d3563sug5m6.apps.googleusercontent.com",
    "MAIL_FROM": "onboarding@resend.dev",
    "ALLOWED_ORIGINS": "https://leva-ai-platform.mauroroqueestudos.workers.dev",
    "MAPS_USER_AGENT": "LevaAi/1.0"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f81a2c22f48c47d9a23cd287dde8a07c"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
