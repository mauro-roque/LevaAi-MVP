# 0.0.0.0 permite uso local e nos provedores de hospedagem.
HOST=0.0.0.0
PORT=3000
# true: contas de exemplo, rota de exemplo e Pix simulado. Nunca recebe dinheiro.
DEMO_MODE=true
# Sem DATABASE_URL usa SQLite local persistente. PostgreSQL usa schema leva_ai_mvp.
DATABASE_URL=
# Gere uma chave aleatória com pelo menos 32 caracteres para ambientes publicados.
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
MAPS_USER_AGENT=LevaAi-AcademicMVP/0.1
# Pix real: DEMO_MODE=false, token de servidor e conta habilitada no gateway.
MERCADO_PAGO_ACCESS_TOKEN=
